{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.hasChildren(['customer','items','total','status']) && newData.child('status').val() === 'pending') || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.child('status').val() === 'pending' || newData.child('status').val() === 'confirmed' || newData.child('status').val() === 'shipped' || newData.child('status').val() === 'delivered' || newData.child('status').val() === 'cancelled'"
      }
    }
  }
}
